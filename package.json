{
	"name": "pi-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "cd packages/tui && npm run build && cd ../ai && npm run build && cd ../coding-agent && npm run build",
		"build:binary": "cd packages/coding-agent && npm run build:binary",
		"build:binary:macos": "./scripts/build-binaries.sh",
		"dev": "concurrently --names \"ai,coding-agent,tui\" --prefix-colors \"cyan,red,magenta\" \"cd packages/ai && npm run dev\" \"cd packages/coding-agent && npm run dev\" \"cd packages/tui && npm run dev\"",
		"dev:tsc": "cd packages/ai && npm run dev:tsc",
		"check": "tsgo --noEmit",
		"test": "npm run test --workspaces --if-present"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"concurrently": "^9.2.1",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"version": "0.0.3",
	"dependencies": {
		"@mariozechner/jiti": "^2.6.5",
		"@mariozechner/pi-coding-agent": "^0.30.2",
		"get-east-asian-width": "^1.4.0",
		"koffi": "^2.15.1"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
